{
  "openapi": "3.1.0",
  "info": {
    "title": "Pleos Reservation Assistant — local MOCK API",
    "version": "1.0.0",
    "description": "Local single-user development API. No external calls. Unauthenticated: loopback access only; do not deploy publicly. All successful commands return HTTP 200. LIVE is reserved in schemas but disabled at startup."
  },
  "servers": [
    {
      "url": "http://127.0.0.1:8080/api/v1"
    }
  ],
  "paths": {
    "/status": {
      "get": {
        "operationId": "getStatus",
        "responses": {
          "200": {
            "description": "MOCK result. Command replay returns its original response snapshot; GET the resource for latest state.",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Status"
                }
              }
            }
          },
          "400": {
            "description": "Invalid input",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Error"
                }
              }
            }
          },
          "404": {
            "description": "Resource not found",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Error"
                }
              }
            }
          },
          "409": {
            "description": "Conflicting command, lifecycle, or authorization",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Error"
                }
              }
            }
          }
        }
      }
    },
