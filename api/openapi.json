  "components": {
    "schemas": {
      "Destination": {
        "type": "object",
        "additionalProperties": false,
        "properties": {
          "name": {
            "type": "string",
            "minLength": 1,
            "maxLength": 100
          },
          "latitude": {
            "type": "number",
            "minimum": -90,
            "maximum": 90
          },
          "longitude": {
            "type": "number",
            "minimum": -180,
            "maximum": 180
          }
        },
        "required": [
          "name",
          "latitude",
          "longitude"
        ]
      },
      "Navigation": {
        "type": "object",
        "additionalProperties": false,
        "properties": {
          "tripId": {
            "type": "string",
            "minLength": 1,
            "maxLength": 100
          },
          "destination": {
            "$ref": "#/components/schemas/Destination"
          },
          "eta": {
            "type": "string",
            "format": "date-time"
          },
          "observedAt": {
            "type": "string",
            "format": "date-time"
          },
          "source": {
            "type": "string",
            "enum": [
              "MOCK",
              "MANUAL",
              "PLEOS"
            ]
          }
        },
        "required": [
          "tripId",
          "destination",
          "eta",
          "observedAt",
          "source"
        ],
        "description": "eta is an absolute RFC3339 instant, at most 24 hours ahead. observedAt must be within 5 minutes. PLEOS is reserved but rejected until ETA time-base verification; never guess a conversion from raw SDK integers. Reuse tripId for the same journey."
      },
      "Party": {
        "type": "object",
        "additionalProperties": false,
        "properties": {
          "adults": {
            "type": "integer",
            "minimum": 1,
            "maximum": 20
          },
          "children": {
            "type": "integer",
            "minimum": 0,
            "maximum": 10
          }
        },
        "required": [
          "adults",
          "children"
        ]
      },
      "SearchRequest": {
        "type": "object",
        "additionalProperties": false,
        "properties": {
          "navigation": {
            "$ref": "#/components/schemas/Navigation"
          },
          "party": {
            "$ref": "#/components/schemas/Party"
          },
          "maxWaitMinutes": {
            "type": "integer",
            "minimum": 0,
            "maximum": 120
          },
          "requiredFeatures": {
            "type": "array",
            "items": {
              "type": "string",
              "enum": [
                "childFriendly",
                "parking"
              ]
            },
            "uniqueItems": true,
            "maxItems": 2
          },
          "preferredCuisines": {
            "type": "array",
            "items": {
              "type": "string",
              "minLength": 1,
              "maxLength": 30
            },
            "uniqueItems": true,
            "maxItems": 8
          },
          "learningConsent": {
            "type": "boolean"
          }
        },
        "required": [
          "navigation",
          "party",
          "maxWaitMinutes",
          "requiredFeatures",
          "preferredCuisines",
          "learningConsent"
        ]
      },
      "InquiryRequest": {
        "type": "object",
        "additionalProperties": false,
        "properties": {
          "candidateId": {
            "type": "string",
            "minLength": 1,
            "maxLength": 100
          }
        },
        "required": [
          "candidateId"
        ]
      },
      "ChangePolicy": {
        "type": "object",
        "additionalProperties": false,
        "properties": {
          "enabled": {
            "type": "boolean"
          },
          "latestTime": {
            "anyOf": [
              {
                "type": "string",
                "format": "date-time"
              },
              {
                "type": "null"
              }
            ]
          },
          "maxAdditionalCostKrw": {
            "type": "integer",
            "minimum": 0,
            "maximum": 100000
          }
        },
        "required": [
          "enabled",
          "maxAdditionalCostKrw"
        ],
        "description": "When enabled, latestTime must be non-null and at or after requestedTime. Budget is cumulative over accepted changes; learning consent grants no booking permission."
      },
      "BookingRequest": {
        "type": "object",
        "additionalProperties": false,
        "properties": {
          "candidateId": {
            "type": "string",
            "minLength": 1,
            "maxLength": 100
          },
          "requestedTime": {
            "type": "string",
            "format": "date-time"
          },
          "allowBooking": {
            "type": "boolean",
            "const": true
          },
          "changePolicy": {
            "$ref": "#/components/schemas/ChangePolicy"
          }
        },
        "required": [
          "candidateId",
          "requestedTime",
          "allowBooking",
          "changePolicy"
        ]
      },
      "ChangeRequest": {
        "type": "object",
        "additionalProperties": false,
        "properties": {
          "requestedTime": {
            "type": "string",
            "format": "date-time"
          },
          "additionalCostKrw": {
            "type": "integer",
            "minimum": 0,
            "maximum": 100000
          },
          "approveAdditionalCost": {
            "type": "boolean"
          }
        },
        "required": [
          "requestedTime",
          "additionalCostKrw",
          "approveAdditionalCost"
        ]
      },
      "InquiryFacts": {
        "type": "object",
        "additionalProperties": false,
        "properties": {
          "childFriendly": {
            "anyOf": [
              {
                "type": "boolean"
              },
              {
                "type": "null"
              }
            ]
          },
          "parking": {
            "anyOf": [
              {
                "type": "boolean"
              },
              {
                "type": "null"
              }
            ]
          },
          "seatsAvailable": {
            "anyOf": [
              {
                "type": "boolean"
              },
              {
                "type": "null"
              }
            ]
          },
          "reservationAvailable": {
            "anyOf": [
              {
                "type": "boolean"
              },
              {
                "type": "null"
              }
            ]
          },
          "nowWaitMinutes": {
            "anyOf": [
              {
                "type": "integer",
                "minimum": 0,
                "maximum": 240
              },
              {
                "type": "null"
              }
            ]
          },
          "arrivalWaitMinutes": {
            "anyOf": [
              {
                "type": "integer",
                "minimum": 0,
                "maximum": 240
              },
              {
                "type": "null"
              }
            ]
          },
          "arrivalAppliesAt": {
            "anyOf": [
              {
                "type": "string",
                "format": "date-time"
              },
              {
                "type": "null"
              }
            ]
          }
        },
        "required": [],
        "description": "Missing/null means no new information. reservationAvailable and arrivalWaitMinutes require arrivalAppliesAt exactly equal to search ETA. NOW values never imply ARRIVAL values."
      },
      "OutcomeRequest": {
        "type": "object",
        "additionalProperties": false,
        "properties": {
          "eventId": {
            "type": "string",
            "minLength": 1,
            "maxLength": 100
          },
          "outcome": {
            "type": "string",
            "enum": [
              "ANSWERED",
              "ACCEPTED",
              "REJECTED",
              "UNKNOWN"
            ]
          },
          "explicitAcceptance": {
            "type": "boolean"
          },
          "observedAt": {
            "type": "string",
            "format": "date-time"
          },
          "acceptedTime": {
            "anyOf": [
              {
                "type": "string",
                "format": "date-time"
              },
              {
                "type": "null"
              }
            ]
          },
          "additionalCostKrw": {
            "type": "integer",
            "minimum": 0,
            "maximum": 100000
          },
          "facts": {
            "anyOf": [
              {
                "$ref": "#/components/schemas/InquiryFacts"
              },
              {
                "type": "null"
              }
            ]
          }
        },
        "required": [
          "eventId",
          "outcome",
          "explicitAcceptance",
          "observedAt",
          "additionalCostKrw"
        ],
        "description": "Mock injection only, not a provider webhook. observedAt is preserved and must not precede the task. Booking/change confirms only on ACCEPTED + explicitAcceptance + exact time + exact cost. Completed/ANSWERED is UNKNOWN. Terminal outcomes cannot be overwritten."
      },
      "Fact": {
        "type": "object",
        "additionalProperties": false,
        "properties": {
          "value": {
            "type": [
              "boolean",
              "integer"
            ]
          },
          "mode": {
            "type": "string",
            "enum": [
              "MOCK",
              "LIVE"
            ]
          },
          "source": {
            "type": "string",
            "enum": [
              "MOCK_FIXTURE",
              "MOCK_CALL"
            ]
          },
          "evidenceRef": {
            "type": "string"
          },
          "observedAt": {
            "type": "string",
            "format": "date-time"
          },
          "appliesAt": {
            "type": "string",
            "format": "date-time"
          },
          "validUntil": {
            "type": "string",
            "format": "date-time"
          },
          "certainty": {
            "type": "string",
            "enum": [
              "CONFIRMED",
              "ESTIMATED",
              "UNKNOWN"
            ]
          },
          "scope": {
            "type": "string",
            "enum": [
              "NOW",
              "ARRIVAL",
              "GENERAL"
            ]
          }
        },
        "required": [
          "value",
          "mode",
          "source",
          "evidenceRef",
          "observedAt",
          "appliesAt",
          "validUntil",
          "certainty",
          "scope"
        ]
      },
      "Candidate": {
        "type": "object",
        "additionalProperties": false,
        "properties": {
          "id": {
            "type": "string",
            "minLength": 1,
            "maxLength": 100
          },
          "name": {
            "type": "string"
          },
          "cuisine": {
            "type": "string"
          },
          "facts": {
            "type": "object",
            "additionalProperties": {
