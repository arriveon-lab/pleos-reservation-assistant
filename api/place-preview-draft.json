        "type": "object",
        "additionalProperties": false,
        "required": [
          "name",
          "cuisine",
          "address",
          "distanceMeters",
          "parking",
          "childFriendly",
          "reservationAvailability",
          "bookable"
        ],
        "properties": {
          "name": {
            "type": "string",
            "minLength": 1
          },
          "cuisine": {
            "type": [
              "string",
              "null"
            ]
          },
          "address": {
            "type": [
              "string",
              "null"
            ]
          },
          "distanceMeters": {
            "type": [
              "integer",
              "null"
            ],
            "minimum": 0
          },
          "parking": {
            "type": "string",
            "const": "UNKNOWN"
          },
          "childFriendly": {
            "type": "string",
            "const": "UNKNOWN"
          },
          "reservationAvailability": {
            "type": "string",
            "const": "UNKNOWN"
          },
          "bookable": {
            "const": false,
            "type": "boolean"
          }
        }
      },
      "Result": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "previewId",
          "generation",
          "state",
          "placeSource",
          "reservationMode",
          "places",
          "fetchedAt",
          "expiresAt",
          "failure",
          "rejectedRecords",
          "mode"
        ],
        "properties": {
          "previewId": {
            "type": "string",
            "format": "uuid"
          },
          "generation": {
            "type": "integer",
            "minimum": 1,
            "maximum": 9007199254740991
          },
          "state": {
            "type": "string",
            "enum": [
              "RESULTS",
              "EMPTY",
              "FAILED",
              "SUPERSEDED",
              "CANCELLED",
              "TIMED_OUT",
              "STALE_GENERATION",
              "REQUEST_CONFLICT",
              "ALREADY_FINISHED",
              "CLOSED"
            ]
          },
          "placeSource": {
            "type": "string",
