          },
          "expiresAt": {
            "type": [
              "string",
              "null"
            ],
            "format": "date-time"
          },
          "failure": {
            "type": [
              "string",
              "null"
            ],
            "enum": [
              "AUTHENTICATION",
              "FORBIDDEN",
              "RATE_LIMITED",
              "TIMEOUT",
              "CANCELLED",
              "UPSTREAM_UNAVAILABLE",
              "INVALID_RESPONSE",
              "INVALID_QUERY",
              null
            ]
          },
          "rejectedRecords": {
            "type": "integer",
            "minimum": 0
          },
          "mode": {
            "type": "string",
            "const": "MOCK"
          }
