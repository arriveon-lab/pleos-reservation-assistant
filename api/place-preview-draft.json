          "state",
          "mode"
        ],
        "properties": {
          "previewId": {
            "type": "string",
            "format": "uuid"
          },
          "generation": {
            "type": "integer",
            "minimum": 1,
            "maximum": 9007199254740991
          },
          "cancelledWork": {
            "type": "boolean"
          },
          "state": {
            "type": "string",
            "const": "CANCEL_REQUESTED"
          },
          "mode": {
            "type": "string",
            "const": "MOCK"
          }
        }
      },
