            "type": "string",
            "format": "uuid"
          },
          "state": {
            "type": "string",
            "const": "CLOSED"
          },
          "mode": {
            "type": "string",
            "const": "MOCK"
          }
        }
      },
      "Cancelled": {
        "type": "object",
        "additionalProperties": false,
