{
  "openapi": "3.1.0",
  "info": {
    "title": "ArriveOn web recommendation sandbox (MOCK only)",
    "version": "0.1.0-draft"
  },
  "servers": [
    {
      "url": "http://127.0.0.1:18084"
    }
  ],
  "paths": {
    "/api/experimental/web-recommendations": {
      "post": {
        "security": [
          {
            "bearerAuth": []
          }
        ],
        "responses": {
          "200": {
            "description": "MOCK experimental result",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Response"
                }
              }
            }
          },
          "400": {
            "description": "Safe error",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Error"
                }
              }
            }
          },
          "401": {
            "description": "Safe error",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Error"
                }
              }
            }
          },
          "404": {
            "description": "Safe error",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Error"
                }
              }
            }
          },
          "409": {
            "description": "Safe error",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Error"
                }
              }
            }
          },
          "429": {
            "description": "Safe error",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Error"
                }
              }
            }
          }
        },
        "parameters": [
          {
            "name": "Idempotency-Key",
            "in": "header",
            "required": true,
            "schema": {
              "type": "string",
              "pattern": "^[A-Za-z0-9._:-]{1,100}$"
            }
          }
        ],
        "requestBody": {
          "required": true,
          "content": {
            "application/json": {
              "schema": {
                "$ref": "#/components/schemas/Request"
              }
            }
          }
        }
      }
    },
    "/api/experimental/web-recommendations/{id}": {
      "get": {
        "security": [
          {
            "bearerAuth": []
          }
        ],
        "responses": {
          "200": {
            "description": "MOCK experimental result",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Saved"
                }
              }
            }
          },
          "400": {
            "description": "Safe error",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Error"
                }
              }
            }
          },
          "401": {
            "description": "Safe error",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Error"
                }
              }
            }
          },
          "404": {
            "description": "Safe error",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Error"
                }
              }
            }
          },
          "409": {
            "description": "Safe error",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Error"
                }
              }
            }
          },
          "429": {
            "description": "Safe error",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Error"
                }
              }
            }
          }
        },
        "parameters": [
          {
            "name": "id",
            "in": "path",
            "required": true,
            "schema": {
              "type": "string",
              "format": "uuid"
            }
          }
        ]
      },
      "delete": {
        "security": [
          {
            "bearerAuth": []
          }
        ],
        "responses": {
          "200": {
            "description": "MOCK experimental result",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Saved"
                }
              }
            }
          },
          "400": {
            "description": "Safe error",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Error"
                }
              }
            }
          },
          "401": {
            "description": "Safe error",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Error"
                }
              }
            }
          },
          "404": {
            "description": "Safe error",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Error"
                }
              }
            }
          },
          "409": {
            "description": "Safe error",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Error"
                }
              }
            }
          },
          "429": {
            "description": "Safe error",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Error"
                }
              }
            }
          }
        },
        "parameters": [
          {
            "name": "id",
            "in": "path",
            "required": true,
            "schema": {
              "type": "string",
              "format": "uuid"
            }
          }
        ]
      }
    },
    "/api/experimental/web-recommendations/{id}/feedback": {
      "put": {
        "security": [
          {
            "bearerAuth": []
          }
        ],
        "responses": {
          "200": {
            "description": "MOCK experimental result",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Saved"
                }
              }
            }
          },
          "400": {
            "description": "Safe error",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Error"
                }
              }
            }
          },
          "401": {
            "description": "Safe error",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Error"
                }
              }
            }
          },
          "404": {
            "description": "Safe error",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Error"
                }
              }
            }
          },
          "409": {
            "description": "Safe error",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Error"
                }
              }
            }
          },
          "429": {
            "description": "Safe error",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Error"
                }
              }
            }
          }
        },
        "parameters": [
          {
            "name": "id",
            "in": "path",
            "required": true,
            "schema": {
              "type": "string",
              "format": "uuid"
            }
          }
        ],
        "requestBody": {
          "required": true,
          "content": {
            "application/json": {
              "schema": {
                "$ref": "#/components/schemas/Feedback"
              }
            }
          }
        }
      }
    },
    "/api/experimental/web-recommendations/{id}/close": {
      "post": {
        "security": [
          {
            "bearerAuth": []
          }
        ],
        "responses": {
          "200": {
            "description": "MOCK experimental result",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Closed"
                }
              }
            }
          },
          "400": {
            "description": "Safe error",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Error"
                }
              }
            }
          },
          "401": {
            "description": "Safe error",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Error"
                }
              }
            }
          },
          "404": {
            "description": "Safe error",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Error"
                }
              }
            }
          },
          "409": {
            "description": "Safe error",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Error"
                }
              }
            }
          },
          "429": {
            "description": "Safe error",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Error"
                }
              }
            }
          }
        },
        "parameters": [
          {
            "name": "id",
            "in": "path",
            "required": true,
            "schema": {
              "type": "string",
              "format": "uuid"
            }
          }
        ]
      }
    }
  },
  "components": {
    "securitySchemes": {
      "bearerAuth": {
        "type": "http",
        "scheme": "bearer"
      }
    },
    "schemas": {
      "Need": {
        "type": "string",
        "enum": [
          "PET_FRIENDLY",
          "INDOOR_PET_FRIENDLY",
          "PARKING",
          "CHILD_FRIENDLY",
          "HIGH_CHAIR",
          "STEP_FREE_ACCESS"
        ]
      },
      "Request": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "viewId",
          "generation",
          "area",
          "requiredNeeds",
          "personalizationConsent"
        ],
        "properties": {
          "viewId": {
            "type": "string",
            "format": "uuid"
          },
          "generation": {
            "type": "integer",
            "minimum": 1,
            "maximum": 1000000000
          },
          "area": {
            "type": "string",
            "minLength": 1,
            "maxLength": 80
          },
          "requiredNeeds": {
            "type": "array",
            "maxItems": 4,
            "items": {
              "$ref": "#/components/schemas/Need"
            },
            "minItems": 1,
            "uniqueItems": true
          },
          "personalizationConsent": {
            "type": "boolean"
          }
        }
      },
      "Feedback": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "selectedOrdinal",
          "fit",
          "reasons"
        ],
        "properties": {
          "selectedOrdinal": {
            "type": "integer",
            "minimum": 1,
            "maximum": 3
          },
          "fit": {
            "type": "string",
            "enum": [
              "MATCH",
              "PARTIAL",
              "NO_MATCH"
            ]
          },
          "reasons": {
            "type": "array",
            "maxItems": 5,
            "items": {
              "type": "string",
              "enum": [
                "NEEDS_MET",
                "INDOOR_PREFERRED",
                "PARKING_REQUIRED",
                "DISTANCE_TOO_FAR",
                "PRICE_TOO_HIGH"
              ]
            },
            "uniqueItems": true
          }
        }
      },
      "Evidence": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "url",
          "title",
          "sourceType",
          "observedAt",
          "sourceUpdatedAt",
          "validUntil",
          "condition",
          "certainty",
          "scope",
          "appliesAt"
        ],
        "properties": {
          "url": {
            "type": "string",
            "format": "uri",
            "pattern": "^https://"
          },
          "title": {
            "type": "string",
            "minLength": 1,
            "maxLength": 200
          },
          "sourceType": {
            "type": "string",
            "enum": [
              "MERCHANT_PAGE",
              "VISITOR_REVIEW",
              "OTHER"
            ]
          },
          "observedAt": {
            "type": "string",
            "format": "date-time"
          },
          "sourceUpdatedAt": {
            "anyOf": [
              {
                "type": "string",
                "format": "date-time"
              },
              {
                "type": "null"
              }
            ]
          },
          "validUntil": {
            "type": "string",
            "format": "date-time"
          },
          "condition": {
            "type": "string",
            "minLength": 1,
            "maxLength": 240
          },
          "certainty": {
            "const": "REPORTED_WEB_NOT_MERCHANT_CONFIRMATION"
          },
          "scope": {
            "const": "GENERAL"
          },
          "appliesAt": {
            "type": "null"
          }
        }
      },
      "Assessment": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "need",
          "verdict",
          "evidence"
        ],
        "properties": {
          "need": {
            "$ref": "#/components/schemas/Need"
          },
          "verdict": {
            "type": "string",
            "enum": [
              "YES",
              "NO",
              "UNKNOWN",
              "CONFLICT"
            ]
          },
          "evidence": {
            "type": "array",
            "maxItems": 256,
            "items": {
              "$ref": "#/components/schemas/Evidence"
            }
          }
        }
      },
      "Candidate": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "ordinal",
          "name",
          "address",
          "identitySourceUrl",
          "fit",
          "assessments",
          "remainingQuestions",
          "identityVerified",
          "bookable",
          "inquiryDispatchAllowed"
        ],
        "properties": {
          "ordinal": {
            "type": "integer",
            "minimum": 1,
            "maximum": 3
          },
          "name": {
            "type": "string",
            "minLength": 1,
            "maxLength": 150
          },
          "address": {
            "type": "string",
            "minLength": 1,
            "maxLength": 250
          },
          "identitySourceUrl": {
            "type": "string",
            "format": "uri",
            "pattern": "^https://"
          },
          "fit": {
            "type": "string",
            "enum": [
              "POTENTIAL_MATCH",
              "NEEDS_CONFIRMATION"
            ]
          },
          "assessments": {
            "type": "array",
            "maxItems": 4,
            "items": {
              "$ref": "#/components/schemas/Assessment"
            }
          },
          "remainingQuestions": {
            "type": "array",
            "maxItems": 4,
            "items": {
              "$ref": "#/components/schemas/Need"
            }
          },
          "identityVerified": {
            "const": false
          },
          "bookable": {
            "const": false
          },
          "inquiryDispatchAllowed": {
            "const": false
          }
        }
      },
      "Result": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "mode",
          "state",
          "observedAt",
          "validUntil",
          "candidates",
          "excludedCandidates",
          "failureReason"
        ],
        "properties": {
          "mode": {
            "type": "string",
            "enum": [
              "MOCK",
              "WEB_SEARCH"
            ]
          },
          "state": {
            "type": "string",
            "enum": [
              "RESULTS",
              "EMPTY",
              "FILTERED",
              "FAILED",
              "CANCELLED",
              "EXPIRED",
              "APPROVAL_REQUIRED",
              "ALREADY_REQUESTED"
            ]
          },
          "observedAt": {
            "anyOf": [
              {
                "type": "string",
                "format": "date-time"
              },
              {
                "type": "null"
              }
            ]
          },
          "validUntil": {
            "anyOf": [
              {
                "type": "string",
                "format": "date-time"
              },
              {
                "type": "null"
              }
            ]
          },
          "candidates": {
            "type": "array",
            "maxItems": 3,
            "items": {
              "$ref": "#/components/schemas/Candidate"
            }
          },
          "excludedCandidates": {
            "type": "integer",
            "minimum": 0,
            "maximum": 8
          },
          "failureReason": {
            "type": ["string", "null"],
            "enum": ["CREDENTIAL_MISSING", "HTTP_REJECTED", "INVALID_RESPONSE", "TRANSPORT_ERROR", null],
            "description": "Safe diagnostic only for FAILED; MOCK results use null."
          }
        }
      },
      "Response": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "requestId",
          "result"
        ],
        "properties": {
          "requestId": {
            "type": "string",
            "format": "uuid"
          },
          "result": {
            "$ref": "#/components/schemas/Result"
          }
        }
      },
      "Saved": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "id",
          "mode",
          "request",
          "feedback",
          "createdAt",
          "deleted"
        ],
        "properties": {
          "id": {
            "type": "string",
            "format": "uuid"
          },
          "mode": {
            "const": "MOCK"
          },
          "request": {
            "anyOf": [
              {
                "$ref": "#/components/schemas/Request"
              },
              {
                "type": "null"
              }
            ]
          },
          "feedback": {
            "anyOf": [
              {
                "$ref": "#/components/schemas/Feedback"
              },
              {
                "type": "null"
              }
            ]
          },
          "createdAt": {
            "type": "string",
            "format": "date-time"
          },
          "deleted": {
            "type": "boolean"
          }
        }
      },
      "Closed": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "state",
          "mode"
        ],
        "properties": {
          "state": {
            "const": "CLOSED"
          },
          "mode": {
            "const": "MOCK"
          }
        }
      },
      "Error": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "code",
          "message",
          "mode"
        ],
        "properties": {
          "code": {
            "type": "string",
            "minLength": 1,
            "maxLength": 100
          },
          "message": {
            "type": "string",
            "minLength": 1,
            "maxLength": 500
          },
          "mode": {
            "const": "MOCK"
          }
        }
      }
    }
  }
}
