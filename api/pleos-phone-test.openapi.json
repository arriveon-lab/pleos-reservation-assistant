{
  "openapi": "3.1.0",
  "info": {
    "title": "Pleos 전화 시험 APK",
    "version": "0.5.0",
    "description": "정차 시험 전용. 인증·목적지 추천 요청은 기존 계약을 사용하고 이 게이트웨이에서 앱 소유권과 등록 모드를 확인합니다."
  },
  "servers": [
    {
      "url": "https://43.201.115.170/pleos-phone"
    }
  ],
  "security": [
    {
      "appBearer": []
    }
  ],
  "paths": {
    "/api/v1/paired-phone": {
      "get": {
        "operationId": "pairedPhoneStatus",
        "summary": "현재 앱의 시험 번호와 최근 통화 결과",
        "responses": {
          "200": {
            "description": "연결 상태",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/PairingStatus"
                }
              }
            }
          },
          "401": {
            "description": "인증 필요"
          }
        }
      },
      "post": {
        "operationId": "issuePleosPairingCode",
        "summary": "5분 유효한 일회용 연결 코드 발급",
        "responses": {
          "200": {
            "description": "연결 코드 발급",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/PairingCode"
                }
              }
            }
          },
          "401": {
            "description": "인증 필요"
          },
          "409": {
            "description": "이미 연결됨"
          },
          "429": {
            "description": "발급 요청이 너무 빠름"
          }
        },
        "requestBody": {
          "required": true,
          "content": {
            "application/json": {
              "schema": {
                "type": "object",
                "additionalProperties": false,
                "maxProperties": 0
              }
            }
          }
        }
      }
    },
    "/api/v1/paired-phone/register": {
      "post": {
        "operationId": "registerPleosReviewNumber",
        "summary": "심사용 LIVE 앱의 시험 휴대폰 번호 등록",
        "security": [
          {
            "appBearer": [],
            "reviewAppKey": []
          }
        ],
        "requestBody": {
          "required": true,
          "content": {
            "application/json": {
              "schema": {
                "type": "object",
                "additionalProperties": false,
                "required": [
                  "phoneNumber"
                ],
                "properties": {
                  "phoneNumber": {
                    "type": "string",
                    "pattern": "^010[0-9]{8}$"
                  }
                }
              }
            }
          }
        },
        "responses": {
          "200": {
            "description": "LIVE 시험 번호 연결",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/PairingStatus"
                }
              }
            }
          },
          "400": {
            "description": "국내 010 번호 형식 오류"
          },
          "401": {
            "description": "앱 인증 필요"
          },
          "403": {
            "description": "심사용 LIVE APK 키가 필요하거나 기능이 비활성"
          },
          "409": {
            "description": "이미 연결된 번호 또는 LIVE 전화 설정 오류"
          },
          "429": {
            "description": "번호 설정 요청이 너무 빠름"
          },
          "503": {
            "description": "회신 수신 허용 설정 실패"
          }
        }
      }
    },
    "/api/v1/paired-phone/disconnect": {
      "post": {
        "operationId": "disconnectPairedPhone",
        "summary": "시험 번호 연결 해제",
        "responses": {
          "200": {
            "description": "연결 해제",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/PairingStatus"
                }
              }
            }
          },
          "401": {
            "description": "인증 필요"
          }
        },
        "requestBody": {
          "required": true,
          "content": {
            "application/json": {
              "schema": {
                "type": "object",
                "additionalProperties": false,
                "maxProperties": 0
              }
            }
          }
        }
      }
    },
    "/api/v1/paired-phone/calls": {
      "post": {
        "operationId": "approvePairedCall",
        "summary": "현재 추천 후보 시험 발신 승인",
        "responses": {
          "200": {
            "description": "통화 상태",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/CallResult"
                }
              }
            }
          },
          "400": {
            "description": "요청 형식 오류"
          },
          "401": {
            "description": "인증 필요"
          },
          "404": {
            "description": "후보를 찾을 수 없음"
          },
          "409": {
            "description": "만료 또는 발신 상태 충돌"
          },
          "429": {
            "description": "시험 한도 도달"
          }
        },
        "requestBody": {
          "required": true,
          "content": {
            "application/json": {
              "schema": {
                "$ref": "#/components/schemas/DialRequest"
              }
            }
          }
        },
        "parameters": [
          {
            "name": "Idempotency-Key",
            "in": "header",
            "required": true,
            "schema": {
              "type": "string",
              "format": "uuid"
            }
          }
        ]
      }
    },
    "/api/v1/paired-phone/calls/{id}": {
      "parameters": [
        {
          "name": "id",
          "in": "path",
          "required": true,
          "schema": {
            "type": "string",
            "format": "uuid"
          }
        }
      ],
      "get": {
        "operationId": "getPairedCall",
        "summary": "현재 앱이 승인한 통화 결과",
        "responses": {
          "200": {
            "description": "통화 결과",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/CallResult"
                }
              }
            }
          },
          "401": {
            "description": "인증 필요"
          },
          "404": {
            "description": "없거나 타인 소유"
          }
        }
      }
    },
    "/api/v1/paired-phone/calls/{id}/change": {
      "parameters": [
        {
          "name": "id",
          "in": "path",
          "required": true,
          "schema": {
            "type": "string",
            "format": "uuid"
          }
        }
      ],
      "post": {
        "operationId": "decidePairedCallbackChange",
        "summary": "앱 소유의 회신 시간 변경을 수락 또는 거절",
        "description": "식당과 통화 중인 요청에만 응답합니다. 수락은 식당 재확인으로 넘어가며, 기존 확정 시간은 식당이 수락한 후 갱신됩니다.",
        "parameters": [
          {
            "name": "Idempotency-Key",
            "in": "header",
            "required": true,
            "schema": {
              "type": "string",
              "format": "uuid"
            }
          }
        ],
        "requestBody": {
          "required": true,
          "content": {
            "application/json": {
              "schema": {
                "$ref": "#/components/schemas/CallbackDecision"
              }
            }
          }
        },
        "responses": {
          "200": {
            "description": "현재 연결과 최신 회신 상태",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/PairingStatus"
                }
              }
            }
          },
          "400": {
            "description": "요청 형식 오류"
          },
          "401": {
            "description": "인증 필요"
          },
          "404": {
            "description": "현재 앱의 실제 시험 예약을 찾을 수 없음"
          },
          "409": {
            "description": "요청 만료, 이미 처리됨, 버전 또는 요청 키 충돌"
          }
        }
      }
    },
    "/api/v1/paired-phone/calls/{id}/delay-change": {
      "parameters": [
        {
          "name": "id",
          "in": "path",
          "required": true,
          "schema": {
            "type": "string",
            "format": "uuid"
          }
        }
      ],
      "post": {
        "operationId": "requestPairedDelayChange",
        "summary": "교통 지연으로 기존 예약의 새 시간 확인 전화 요청",
        "description": "확정된 시험 예약의 등록 번호로 전화를 겁니다. 이 요청으로 비용이 발생할 수 있으며 식당이 수락해야 예약 시간이 갱신됩니다. 변경 결과가 미확인이고 canRetry가 true이면 최신 버전과 새 요청 키로 같은 시각을 재확인할 수 있습니다.",
        "parameters": [
          {
            "name": "Idempotency-Key",
            "in": "header",
            "required": true,
            "schema": {
              "type": "string",
              "format": "uuid"
            }
          }
        ],
        "requestBody": {
          "required": true,
          "content": {
            "application/json": {
              "schema": {
                "type": "object",
                "additionalProperties": false,
                "required": [
                  "version",
                  "proposedTime"
                ],
                "properties": {
                  "version": {
                    "type": "integer",
                    "minimum": 1
                  },
                  "proposedTime": {
                    "type": "string",
                    "pattern": "^([01][0-9]|2[0-3]):[0-5][0-9]$"
                  }
                }
              },
              "example": {
                "version": 4,
                "proposedTime": "19:30"
              }
            }
          }
        },
        "responses": {
          "200": {
            "description": "연결 상태와 변경 확인 결과",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/PairingStatus"
                }
              }
            }
          },
          "400": {
            "description": "요청 형식 또는 시각 오류"
          },
          "401": {
            "description": "인증 필요"
          },
          "403": {
            "description": "시험 번호 연결 필요"
          },
          "404": {
            "description": "현재 앱의 확정 시험 예약을 찾을 수 없음"
          },
          "409": {
            "description": "진행 중인 통화 또는 상태 충돌"
          },
          "429": {
            "description": "연결별 전화 한도 도달"
          }
        }
      }
    }
  },
  "components": {
    "securitySchemes": {
      "appBearer": {
        "type": "http",
        "scheme": "bearer"
      },
      "reviewAppKey": {
        "type": "apiKey",
        "in": "header",
        "name": "X-Pleos-Review-Key",
        "description": "비공개 심사용 LIVE APK의 배포 키입니다."
      }
    },
    "schemas": {
      "PairingCode": {
        "type": "object",
        "required": [
          "pairingCode",
          "expiresAt"
        ],
        "properties": {
          "pairingCode": {
            "type": "string",
            "minLength": 10,
            "maxLength": 10
          },
          "expiresAt": {
            "type": "string",
            "format": "date-time"
          }
        }
      },
      "PairingStatus": {
        "type": "object",
        "required": [
          "active"
        ],
        "properties": {
          "active": {
            "type": "boolean"
          },
          "phoneLast4": {
            "type": "string",
            "pattern": "^[0-9]{4}$"
          },
          "mode": {
            "enum": [
              "MOCK",
              "LIVE"
            ]
          },
          "expiresAt": {
            "type": "string",
            "format": "date-time"
          },
          "latest": {
            "anyOf": [
              {
                "$ref": "#/components/schemas/CallResult"
              },
              {
                "type": "null"
              }
            ]
          },
          "delayChangeEnabled": {
            "type": "boolean"
          },
          "callback": {
            "description": "이 앱에서 최근 받은 식당 회신의 예약",
            "anyOf": [
              {
                "$ref": "#/components/schemas/CallResult"
              },
              {
                "type": "null"
              }
            ]
          },
          "reviewRegistrationAvailable": {
            "type": "boolean"
          },
          "reviewTrial": {
            "type": "boolean"
          }
        }
      },
      "DialRequest": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "taskId",
          "candidateOrdinal",
          "date",
          "time",
          "reservationName"
        ],
        "properties": {
          "taskId": {
            "type": "string",
            "format": "uuid"
          },
          "candidateOrdinal": {
            "type": "integer",
            "minimum": 1,
            "maximum": 3
          },
          "date": {
            "type": "string",
            "format": "date"
          },
          "time": {
            "type": "string",
            "pattern": "^([01][0-9]|2[0-3]):[0-5][0-9]$"
          },
          "reservationName": {
            "type": "string",
            "minLength": 1,
            "maxLength": 40
          }
        }
      },
      "CallResult": {
        "type": "object",
        "required": [
          "id",
          "mode",
          "status",
          "restaurantName",
          "date",
          "requestedTime",
          "partySize",
          "notice",
          "requirements"
        ],
        "properties": {
          "id": {
            "type": "string",
            "format": "uuid"
          },
          "mode": {
            "enum": [
              "MOCK",
              "LIVE"
            ]
          },
          "status": {
            "enum": [
              "RESERVED",
              "CALLING",
              "CONFIRMED",
              "DECLINED",
              "FAILED",
              "UNKNOWN"
            ]
          },
          "restaurantName": {
            "type": "string"
          },
          "date": {
            "type": "string",
            "format": "date"
          },
          "requestedTime": {
            "type": "string"
          },
          "confirmedTime": {
            "type": [
              "string",
              "null"
            ]
          },
          "partySize": {
            "type": "integer"
          },
          "notice": {
            "type": "string"
          },
          "requirements": {
            "type": "object",
            "additionalProperties": {
              "type": "string"
            }
          },
          "transportStatus": {
            "type": [
              "string",
              "null"
            ]
          },
          "version": {
            "type": "integer",
            "minimum": 1
          },
          "delayChange": {
            "anyOf": [
              {
                "$ref": "#/components/schemas/DriverDelayChange"
              },
              {
                "type": "null"
              }
            ]
          },
          "change": {
            "anyOf": [
              {
                "$ref": "#/components/schemas/CallbackChange"
              },
              {
                "type": "null"
              }
            ]
          }
        }
      },
      "DriverDelayChange": {
        "type": "object",
        "required": [
          "status",
          "originalTime",
          "proposedTime"
        ],
        "properties": {
          "status": {
            "enum": [
              "CALLING",
              "APPLIED",
              "REJECTED",
              "UNKNOWN"
            ]
          },
          "originalTime": {
            "type": "string",
            "pattern": "^([01][0-9]|2[0-3]):[0-5][0-9]$"
          },
          "proposedTime": {
            "type": "string",
            "pattern": "^([01][0-9]|2[0-3]):[0-5][0-9]$"
          },
          "canRetry": {
            "type": "boolean",
            "description": "직전 확인 통화가 미확인으로 끝난 같은 시각을 명시적으로 다시 문의할 수 있으면 true. 생략하면 false."
          }
        }
      },
      "CallbackChange": {
        "type": "object",
        "required": [
          "id",
          "status",
          "originalTime",
          "proposedTime",
          "reason",
          "expiresAt",
          "additionalCostKrw",
          "version",
          "canDecide"
        ],
        "properties": {
          "id": {
            "type": "string",
            "pattern": "^[0-9a-f]{32}$"
          },
          "status": {
            "enum": [
              "AWAITING_USER",
              "RECONFIRMING",
              "APPLIED",
              "REJECTED",
              "EXPIRED",
              "UNKNOWN"
            ]
          },
          "originalTime": {
            "type": "string",
            "pattern": "^([01][0-9]|2[0-3]):[0-5][0-9]$"
          },
          "proposedTime": {
            "type": "string",
            "pattern": "^([01][0-9]|2[0-3]):[0-5][0-9]$"
          },
          "reason": {
            "type": "string",
            "maxLength": 160
          },
          "expiresAt": {
            "type": "string",
            "format": "date-time"
          },
          "additionalCostKrw": {
            "enum": [
              0,
              null
            ],
            "description": "0 when confirmed by the restaurant, null when the restaurant did not mention a fee."
          },
          "version": {
            "type": "integer",
            "minimum": 1
          },
          "canDecide": {
            "type": "boolean"
          }
        }
      },
      "CallbackDecision": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "changeId",
          "version",
          "approve"
        ],
        "properties": {
          "changeId": {
            "type": "string",
            "pattern": "^[0-9a-f]{32}$"
          },
          "version": {
            "type": "integer",
            "minimum": 1
          },
          "approve": {
            "type": "boolean"
          }
        }
      }
    }
  }
}
