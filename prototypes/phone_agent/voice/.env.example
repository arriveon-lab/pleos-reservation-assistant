# Copy to work/phone-live.env and chmod 600; never put real values into this example.
LIVEKIT_URL=
LIVEKIT_API_KEY=
LIVEKIT_API_SECRET=
LIVEKIT_SIP_URI=
TELKIT_NUMBER=
TELKIT_NUMBER_ID=
# Telkit credentials can also be loaded from work/telkit-private (0600 files).
TELKIT_API_KEY=
TELKIT_SIP_USERNAME=
TELKIT_SIP_PASSWORD=
LIVEKIT_OUTBOUND_TRUNK_ID=
LIVEKIT_INBOUND_TRUNK_ID=
PHONE_LIVE_ENABLED=false
PHONE_INBOUND_ENABLED=false
PHONE_ALLOWED_NUMBERS=
PHONE_RESTAURANT_NUMBERS={}
PHONE_MAX_SECONDS=180
PHONE_DAILY_CALLS=1
# NC is included with LiveKit Cloud; adaptive uses the local development allowance.
# Keep Build/free plan limits. Paid voice isolation is not enabled.
PHONE_NOISE_SUPPRESSION=true
PHONE_ECHO_CANCELLATION=false
# Experimental server AEC: initial delay estimate, not a measured SIP round trip.
PHONE_ECHO_DELAY_MS=200
PHONE_INPUT_LEVEL_PROBE=false
PHONE_INTERRUPTION_MODE=adaptive
PHONE_DATABASE=data/phone-agent-prototype.sqlite3
PHONE_AGENT_NAME=arriveon-reservation
PHONE_STT_MODEL=assemblyai/universal-3-6-pro
PHONE_LLM_MODEL=google/gemma-4-31b-it
PHONE_TTS_MODEL=cartesia/sonic-3-2026-01-12
# Korean native Jiwoo; new voice setting still needs a listening test.
PHONE_TTS_VOICE=15628352-2ede-4f1b-89e6-ceda0c983fbc
