      "MockPhoneReceipt": {
        "type": "object",
        "required": [
          "attemptId",
          "mode",
          "candidateOrdinal",
          "restaurantName",
          "status",
          "conditionStatus",
          "availabilityStatus",
          "bookingRequested",
          "date",
          "requestedTime",
          "confirmedTime",
          "partySize",
          "requiredConditions",
          "requirementChecks",
          "nextCandidate",
          "externalCalls",
          "notice",
          "conversation"
        ],
        "properties": {
          "attemptId": {
            "type": "string",
            "pattern": "^[a-f0-9]{32}$"
          },
          "mode": {
            "const": "MOCK"
          },
          "candidateOrdinal": {
            "type": "integer",
            "minimum": 1,
            "maximum": 3
          },
          "restaurantName": {
            "type": "string"
          },
          "status": {
            "enum": [
              "CONFIRMED",
              "DECLINED",
              "UNKNOWN",
              "FAILED"
            ]
          },
          "conditionStatus": {
            "enum": [
              "MET",
              "UNMET",
              "UNKNOWN"
            ]
          },
          "availabilityStatus": {
            "enum": [
              "AVAILABLE",
              "UNAVAILABLE",
              "UNKNOWN"
            ]
          },
          "bookingRequested": {
            "type": "boolean"
          },
          "date": {
            "type": "string",
            "format": "date"
          },
          "requestedTime": {
            "type": "string",
            "pattern": "^[0-2][0-9]:[0-5][0-9]$"
          },
          "confirmedTime": {
            "type": [
              "string",
              "null"
            ],
            "pattern": "^[0-2][0-9]:[0-5][0-9]$"
          },
          "partySize": {
            "type": "integer",
            "minimum": 1,
            "maximum": 30
          },
          "requiredConditions": {
            "type": "array",
            "items": {
              "type": "string"
            }
          },
          "requirementChecks": {
            "type": "object",
            "additionalProperties": {
              "enum": [
                "CONFIRMED",
                "UNMET",
                "UNKNOWN"
              ]
            }
          },
          "nextCandidate": {
            "type": [
              "object",
              "null"
            ],
            "required": [
              "ordinal",
              "name",
              "address"
            ],
            "properties": {
              "ordinal": {
                "type": "integer",
                "minimum": 1,
                "maximum": 3
              },
              "name": {
                "type": "string"
              },
              "address": {
                "type": "string"
              }
            }
          },
          "externalCalls": {
            "const": 0
          },
          "notice": {
            "type": "string"
          },
          "conversation": {
            "type": "array",
            "items": {
              "type": "object",
              "required": [
                "speaker",
                "message"
              ],
              "properties": {
                "speaker": {
                  "enum": [
                    "agent",
                    "restaurant",
                    "system"
                  ]
                },
                "message": {
                  "type": "string"
                }
              }
            }
          }
        }
      }
    }
